license: CC-BY-4.0
repository-code: "https://github.com/ishgits/acgut-thermodynamics"
keywords:
  - prebiotic chemistry
  - nucleotide formation
  - computational chemistry
  - thermodynamics
  - origins of life
  - reproducibility
